# ─────────────────────────────────────────────────────────────────────────────
# AMANI Cosmetics : réglages de l'application
# Copier ce fichier en « .env » et remplir les valeurs. Le fichier .env n'est
# jamais versionné : il contient les secrets propres à chaque installation.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="AMANI Cosmetics"
# local (développement), recette (validation par la direction) ou production
APP_ENV=local
# Généré par « php artisan key:generate ». Ne jamais le changer en production :
# il chiffre les secrets de double authentification du personnel.
APP_KEY=
# true seulement en développement
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de données : MySQL 8, InnoDB, utf8mb4 ───────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amani
DB_USERNAME=amani
DB_PASSWORD=

# ── Redis : cache, sessions, files de travaux (Horizon) ──────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true en recette et en production (HTTPS obligatoire)
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log

# ── Boutique ─────────────────────────────────────────────────────────────────
# Langues ouvertes : français au lancement ; « fr,en » ouvrira l'anglais.
BOUTIQUE_LANGUES=fr
# Nombre de jours pendant lesquels un produit garde le badge « Nouveau »
BOUTIQUE_NOUVEAUTE_JOURS=30
# Comptes officiels (laisser vide tant qu'ils ne sont pas fournis : rien ne s'affiche)
AMANI_INSTAGRAM=
AMANI_TIKTOK=
AMANI_WHATSAPP=

# ── Codes de connexion par SMS ───────────────────────────────────────────────
# « journal » écrit le SMS dans storage/logs au lieu de l'envoyer (développement
# et recette seulement : refusé en production). Le prestataire reste à choisir.
SMS_PILOTE=journal
SMS_EXPEDITEUR=AMANI
# Recette seulement (jamais en production) : affiche aussi le SMS à l'écran.
SMS_AFFICHER_EN_RECETTE=false

# ── Recette en ligne (Vercel) ─────────────────────────────────────────────────
# Compte de la propriétaire créé par RecetteSeeder s'il n'existe pas
# (jamais en production : le premier compte s'y crée à la main).
RECETTE_PROPRIETAIRE_EMAIL=
RECETTE_PROPRIETAIRE_MOT_DE_PASSE=
RECETTE_PROPRIETAIRE_PRENOM=

# ── Photos ────────────────────────────────────────────────────────────────────
# Les photos et leurs déclinaisons AVIF et WebP sont rangées dans
# storage/app/public/medias. En production, MEDIA_URL est l'adresse servie par
# Cloudflare devant le serveur (adresse à définir avec le nom de domaine).
FILESYSTEM_DISK=local
MEDIA_DISK=medias
MEDIA_URL=
MEDIA_QUEUE=medias
# Pilote d'images : imagick (paquets php8.3-imagick et libheif-plugin-aomenc,
# indispensables pour écrire l'AVIF sur Ubuntu 24.04).
IMAGE_DRIVER=imagick

# ── Emails (facultatifs, cahier §17 : service à choisir) ─────────────────────
MAIL_MAILER=log
# À remplacer par l'adresse du domaine AMANI quand il sera choisi.
MAIL_FROM_ADDRESS="contact@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=

# ── Tableau de bord des files ────────────────────────────────────────────────
# Adresse : /administration/files (réservé à la permission technique.superviser)
HORIZON_PATH=administration/files

VITE_APP_NAME="${APP_NAME}"
